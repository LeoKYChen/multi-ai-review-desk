# Copy to wrangler.toml and replace the ID from your Cloudflare D1 database.
name = "multi-ai-review-desk"
main = "src/worker.mjs"
compatibility_date = "2026-10-20"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "multi-ai-review-desk-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

# Never commit tokens: npx wrangler secret put OWNER_TOKEN
