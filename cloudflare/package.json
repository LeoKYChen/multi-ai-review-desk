{
  "name": "multi-ai-review-desk-cloudflare",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply multi-ai-review-desk-db --local",
